  <message id="50004" name="SYS_ICD_GCS_FLCC_OBJECT_AVOIDANCE_CMD">
  <description>TC4 (OA).</description>
    <field type="uint8_t" name="OA_Mode" units="N/A">0: Normal, 1: OA Level1, 2: OA Level2[SF:N/A, MIN:0, MAX:2]</field>
  </message>

  <!-- SAR_ICD_PNU.md section 3.4 gives these two messages verbatim.  Two deliberate
       departures from the house style above, both required by ICD section 3:
         - NO units="N/A".  "For fields without units, omit the XML units attribute
           rather than setting units=N/A"; the documentation shows N/A instead.
         - the descriptions are the ICD's own words, so that the FC dialect and
           Lumir's generated code are diff-able.
       Field names and their capitalisation are fixed by the ICD and must not be
       tidied.  CRC_EXTRA is generated from this XML and compared at both ends. -->
  <message id="50050" name="SYS_ICD_GCS_FLCC_SAR_CTRL">
  <description>SAR observation control from GCS to FLCC. One initial request and at most one GCS retry; repeated commands must not toggle observation.</description>
    <field type="uint8_t" name="Observation_Control">Observation control: 0 Prepare, 1 Start, 2 Stop. Values 3 through 255 are undefined.</field>
    <field type="uint8_t" name="Observation_Mode">Observation mode selection. All values from 0 through 255 are allowed; detailed mapping is TBD.</field>
  </message>

